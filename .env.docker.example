# Copy to `.env` on your server and edit values before `docker compose up`
POSTGRES_USER=linqi
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=linqi
SESSION_SECRET=change-me-long-random-secret
APP_PORT=80

# First boot only — seeds admin/admin123 when users table is empty. Set to false after first login.
SEED_DEFAULT_ADMIN=true
